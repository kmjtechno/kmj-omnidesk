    "artifactRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "run_id",
        "kind",
        "relative_path",
        "content_type",
        "size_bytes",
        "sha256",
        "created_at",
        "producer",
        "immutable"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^M4-T[1-6]-R[0-9]{2,}$"
        },
        "kind": {
          "enum": [
            "RUN_JSON",
            "EVENT_LOG",
            "CANDIDATE_LOG",
            "NETWORK_DIAGNOSTIC",
            "CONTROL_PROBE",
            "RECONNECT_LOG",
            "BUILD_METADATA",
            "SUMMARY",
            "CSV",
            "OTHER"
          ]
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "content_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component",
            "version"
          ],
          "properties": {
            "component": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "immutable": {
          "const": true
        }
      }
    }
